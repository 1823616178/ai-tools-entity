# ==================== Nuxt 环境变量 ====================
# 所有自定义环境变量以 NUXT_ 前缀命名，与 runtimeConfig 自动对应
# 格式: NUXT_<section>_<key>=<value>

# ---------- 数据库 (section: db) ----------
NUXT_DB_HOST=192.168.1.111
NUXT_DB_PORT=53306
NUXT_DB_USERNAME=hanvon
NUXT_DB_PASSWORD=hanvon123
NUXT_DB_DATABASE=aitool

# ---------- Redis (section: redis) ----------
NUXT_REDIS_HOST=192.168.1.166
NUXT_REDIS_PORT=56379
NUXT_REDIS_PASSWORD=digital@Library
NUXT_REDIS_DB=0

# ---------- LLM (section: llm) ----------
NUXT_LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
NUXT_LLM_API_KEY=sk-0c5773fdc60d46b7afd79caa6cb2ce97
NUXT_LLM_MODEL=deepseek-v4-flash
# 输入 token 预算，用于文件问题推荐等接口截断文件正文
NUXT_LLM_MAX_INPUT_TOKENS=8000

# ---------- 文件问题推荐 (section: documentRecommendedQuestions) ----------
# 默认生成的推荐问题数量（1-10）
NUXT_DOCUMENT_RECOMMENDED_QUESTIONS_QUESTION_COUNT=3

# ---------- NER / 实体统一服务 (section: ner) ----------
# 统一 API（api_large.py）的 /ner 接口
NUXT_NER_API_URL=http://192.168.1.45:8008/ner

# ---------- 句读服务 (section: punctuation) ----------
# 句读 API（api_judou.py）的 /predict 接口
NUXT_PUNCTUATION_API_URL=http://192.168.1.45:8009/predict

# ---------- OCR (section: paddleOcr) ----------
NUXT_PADDLE_OCR_URL=http://localhost:58700/ocr

# ---------- OCR 推理后端（可选） ----------
# ONNX Runtime Execution Provider 列表，按优先级从左到右尝试
# Intel CPU/iGPU/Arc A770 推荐：OpenVINOExecutionProvider,CPUExecutionProvider
OCR_PROVIDERS=OpenVINOExecutionProvider,CPUExecutionProvider

# ---------- 日志 (section: logDir) ----------
NUXT_LOG_DIR=./logs

# ---------- OCR 日志（仅 Docker 环境使用） ----------
OCR_LOG_LEVEL=INFO
OCR_LOG_DIR=./logs
OCR_LOG_FILE=ocr.log
OCR_LOG_BACKUP_DAYS=30
