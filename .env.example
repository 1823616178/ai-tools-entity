# LLM 大模型配置
# Base URL of the LLM API (e.g., OpenAI compatible endpoint)
LLM_BASE_URL=https://aiping.cn/api/v1
# API Key for the LLM service
LLM_API_KEY=QC-bf1abcef0d24bbcfd549b61bc6d335ba-2f1e7634b1e33338a58c48e09a929c44
# Model name to use
LLM_MODEL=Qwen3.5-Flash

# MySQL 数据库配置
DB_HOST=192.168.1.111
DB_PORT=53306
DB_USERNAME=hanvon
DB_PASSWORD=hanvon123
DB_DATABASE=aitool

# Redis 缓存配置
REDIS_HOST=192.168.1.166
REDIS_PORT=56379
REDIS_PASSWORD=digital@Library
REDIS_DB=0

# PaddleOCR 服务配置
# 本地开发填 http://localhost:8000/ocr
# Docker 环境填 http://paddle-ocr:8000/ocr
PADDLE_OCR_URL=http://localhost:8000/ocr

# OCR 日志配置
OCR_LOG_LEVEL=INFO
OCR_LOG_DIR=./logs
OCR_LOG_FILE=ocr.log
OCR_LOG_BACKUP_DAYS=30

# OCR XPU 加速配置（可选，用于 Intel Arc GPU / Data Center GPU Flex / Max 等）
# 启用前请确保宿主机已安装 Intel GPU 驱动和 oneAPI Base Toolkit
OCR_USE_XPU=false
OCR_USE_GPU=false
SYCL_DEVICE_FILTER=level_zero:gpu
ONEAPI_DEVICE_SELECTOR=level_zero:gpu
ZE_AFFINITY_MASK=0
