# ==================== Nuxt 环境变量示例 ====================
# 复制为 .env 后修改实际值
# 所有自定义环境变量以 NUXT_ 前缀命名，与 runtimeConfig 自动对应

# ---------- 数据库 (section: db) ----------
NUXT_DB_HOST=192.168.1.111
NUXT_DB_PORT=53306
NUXT_DB_USERNAME=hanvon
NUXT_DB_PASSWORD=hanvon123
NUXT_DB_DATABASE=aitool

# ---------- Redis (section: redis) ----------
NUXT_REDIS_HOST=192.168.1.166
NUXT_REDIS_PORT=56379
NUXT_REDIS_PASSWORD=digital@Library
NUXT_REDIS_DB=0

# ---------- LLM (section: llm) ----------
NUXT_LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
NUXT_LLM_API_KEY=your_api_key_here
NUXT_LLM_MODEL=deepseek-v4-flash

# ---------- NER (section: ner) ----------
NUXT_NER_API_URL=http://192.168.1.45:54104/predict

# ---------- PaddleOCR (section: paddleOcr) ----------
NUXT_PADDLE_OCR_URL=http://192.168.1.45:8000/ocr

# ---------- 日志 (section: logDir) ----------
NUXT_LOG_DIR=./logs

# ---------- OCR 日志（仅 Docker 环境使用） ----------
OCR_LOG_LEVEL=INFO
OCR_LOG_DIR=./logs
OCR_LOG_FILE=ocr.log
OCR_LOG_BACKUP_DAYS=30

# ---------- OCR XPU 加速（可选） ----------
OCR_USE_XPU=false
OCR_USE_GPU=false
SYCL_DEVICE_FILTER=level_zero:gpu
ONEAPI_DEVICE_SELECTOR=level_zero:gpu
ZE_AFFINITY_MASK=0
