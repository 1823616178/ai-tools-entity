# PaddleOCR Intel GPU 服务镜像（基于 PaddleCustomDevice intel_gpu 后端）
# 用于 Intel Arc A770 / Data Center GPU Flex / Max 等
# 参考：https://github.com/PaddlePaddle/PaddleCustomDevice/blob/develop/backends/intel_gpu/README.md
#
# 注意：
# 1. 宿主机必须已安装 Intel GPU 驱动（i915/xe）
# 2. 容器运行时需映射 /dev/dri 设备
# 3. 本镜像会源码编译 paddle_custom_intel_gpu，构建时间较长

FROM intel/oneapi-basekit:2024.2.0-0-devel-ubuntu22.04

WORKDIR /app

# 安装系统依赖和编译工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    poppler-utils \
    libreoffice \
    fonts-wqy-zenhei \
    fonts-wqy-microhei \
    wget \
    curl \
    git \
    cmake \
    build-essential \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# 设置 Python3 为默认 python
RUN ln -sf /usr/bin/python3 /usr/bin/python

# 升级 pip
RUN python -m pip install --upgrade pip setuptools wheel

# 安装 PaddlePaddle CPU develop 版本（PaddleCustomDevice 插件需要）
RUN python -m pip install paddlepaddle==0.0.0 -f https://www.paddlepaddle.org.cn/whl/linux/cpu-mkl/develop.html

# 编译并安装 paddle_custom_intel_gpu 插件
# 注意：编译前必须激活 oneAPI 环境变量（source load.sh 或 setvars.sh）
RUN git clone --recursive https://github.com/PaddlePaddle/PaddleCustomDevice /tmp/PaddleCustomDevice && \
    cd /tmp/PaddleCustomDevice && \
    git submodule sync && \
    git submodule update --remote --init --recursive && \
    cd backends/intel_gpu && \
    (test -f load.sh && bash load.sh || true) && \
    mkdir build && cd build && \
    . /opt/intel/oneapi/setvars.sh && \
    cmake .. && \
    make -j $(nproc) && \
    python -m pip install dist/paddle_custom_intel_gpu*.whl && \
    rm -rf /tmp/PaddleCustomDevice

# 验证插件安装
RUN python -c "import paddle; assert 'intel_gpu' in paddle.device.get_all_custom_device_type(), 'intel_gpu 插件未安装成功'"

# 安装 PaddleOCR 服务其余 Python 依赖
COPY requirements-xpu.txt ./
RUN python -m pip install --no-cache-dir -r requirements-xpu.txt

# 复制业务代码
COPY . /app

# 预下载模型到 models/ 目录
RUN python -c "from paddleocr import PaddleOCR; PaddleOCR(use_angle_cls=True, lang='ch', show_log=False)" || true

# 创建非 root 用户
RUN useradd -m -u 1001 ocr && chown -R ocr:ocr /app
USER ocr

EXPOSE 8000

ENV OCR_HOST=0.0.0.0
ENV OCR_PORT=8000
ENV OCR_USE_XPU=true
ENV OCR_USE_GPU=true
ENV OCR_WORKERS=1
ENV OCR_MAX_CONCURRENT=2
ENV OCR_THREAD_WORKERS=2
ENV OCR_LOG_LEVEL=INFO
ENV OCR_LOG_DIR=./logs
ENV OCR_LOG_FILE=ocr.log
ENV OCR_LOG_BACKUP_DAYS=30

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["python", "main.py"]
